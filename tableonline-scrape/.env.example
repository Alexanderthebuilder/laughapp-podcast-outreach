# Copy to .env (gitignored) and fill in. Never inline a key in source.

# --- Phase 3: the one hard blocker ----------------------------------------
# GCP project with billing enabled and "Places API (New)" enabled specifically
# (NOT the legacy Places API). Restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# --- Phase 7 ---------------------------------------------------------------
# Pipedrive personal settings -> API token
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# --- Phase 6 (deferrable) --------------------------------------------------
# One of these. Set EMAIL_VERIFIER to millionverifier | bouncer | none
EMAIL_VERIFIER=none
MILLIONVERIFIER_API_KEY=
BOUNCER_API_KEY=

# --- Phase 4 Tier 3 (only if Cloudflare-blocked domains appear) ------------
FIRECRAWL_API_KEY=

# --- Crawl identity --------------------------------------------------------
# Principle 4: a real User-Agent with a reachable contact address.
CRAWL_CONTACT_EMAIL=alex@letsumai.com
